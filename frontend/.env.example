# Base URL of the Spring Boot API, e.g. https://trackhire-9ve0.onrender.com/api
VITE_API_BASE_URL=

# AES-256 key used to decrypt the encrypted job endpoints.
# Must be byte-identical to RESPONSE_ENCRYPTION_KEY on the backend.
# Generate with: openssl rand -base64 32
VITE_RESPONSE_ENCRYPTION_KEY=

# Google Sign-In. The same OAuth Web client id the backend holds in
# GOOGLE_CLIENT_ID. There is no client secret in the ID-token flow.
VITE_GOOGLE_CLIENT_ID=
